{
  "source": "phase-c-sets.md, section C3 (Ten fixed tasks). Build requests are verbatim.",
  "tasks": [
    {
      "id": "T01",
      "reference": "Northline Field Ops",
      "starter_id": "northline-ops",
      "build_request": "Build a fleet-operations dashboard for a coastal research team: status summary, one prominent signal, vessel/asset table, and acknowledge CTA.",
      "predicates": [
        {
          "item": "status summary",
          "kind": "text",
          "pattern": "\\bstatus\\b|\\bsummary\\b",
          "rule": "the words status or summary appear in the page text"
        },
        {
          "item": "one prominent signal",
          "kind": "count",
          "any": [
            {
              "attr": "role=alert"
            },
            {
              "attr": "role=status"
            },
            {
              "attr": "aria-live"
            },
            {
              "class": "alert"
            },
            {
              "class": "signal"
            },
            {
              "class": "banner"
            }
          ],
          "min": 1,
          "rule": "one visible alert, status, live region, signal or banner element"
        },
        {
          "item": "vessel/asset table",
          "kind": "count",
          "any": [
            {
              "tag": "tr",
              "has": "td"
            }
          ],
          "min": 3,
          "rule": "a visible table with at least 3 rows that hold data cells",
          "per_table": true
        },
        {
          "item": "acknowledge CTA",
          "kind": "control_name",
          "pattern": "acknowledg",
          "rule": "a button or link named acknowledge"
        }
      ]
    },
